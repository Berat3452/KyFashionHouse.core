@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link">
                Merhaba, @UserManager.GetUserName(User)!
            </span>

            <li class="nav-item">
                <a class="nav-link"
                   asp-controller="Home"
                   asp-action="Siparislerim">
                    Siparişlerim
                </a>
            </li>

        </li>
        <li class="nav-item">
            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="/"
                  method="post">
                <button type="submit" class="nav-link btn btn-link">
                    Çıkış Yap
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Register">
                Kayıt Ol
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Login">
                Giriş Yap
            </a>
        </li>
    }
</ul>