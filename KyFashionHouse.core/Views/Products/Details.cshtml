@model KyFashionHouse.core.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-5">
    <div class="row align-items-center">

        <div class="col-md-6 mb-4">
            <img src="@Url.Content(Model.ImageUrl)"
                 alt="@Model.Name"
                 class="img-fluid rounded"
                 style="width: 100%; max-height: 550px; object-fit: contain;" />
        </div>

        <div class="col-md-6">
            <h2 class="mb-3">@Model.Name</h2>

            <h3 class="text-primary mb-4">
                @Model.Price.ToString("N2") ₺
            </h3>

            <p>
                <strong>Kategori:</strong> @Model.Category
            </p>

            @if (Model.Stock > 0)
            {
                <p class="text-success">
                    Stokta @Model.Stock adet var
                </p>

                <form asp-controller="Cart"
                      asp-action="SepeteEkle"
                      method="post">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa fa-shopping-cart mr-2"></i>
                        Sepete Ekle
                    </button>
                </form>
            }
            else
            {
                <p class="text-danger">Bu ürün stokta yok.</p>
            }

            <a asp-controller="Products"
               asp-action="Tshirtler"
               class="btn btn-outline-secondary mt-3">
                Ürünlere Geri Dön
            </a>
        </div>

    </div>
</div>
