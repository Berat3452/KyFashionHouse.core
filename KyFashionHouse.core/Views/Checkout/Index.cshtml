@model KyFashionHouse.core.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Siparişi Tamamla";
}

<div class="container py-5">
    <h2>Siparişi Tamamla</h2>
    <p>Teslimat bilgilerini doldur.</p>

    <form asp-controller="Checkout" asp-action="Index" method="post">
        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ShippingAddress" class="form-label"></label>
            <textarea asp-for="ShippingAddress" class="form-control" rows="4"></textarea>
            <span asp-validation-for="ShippingAddress" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Siparişi Onayla
        </button>
    </form>
</div>
