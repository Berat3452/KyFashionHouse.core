@{
    ViewData["Title"] = "T-Shirtler";
}

<div class="container-fluid py-5">

    <!-- SAYFA BAŞLIĞI -->
    <div class="text-center mb-5">

        <h2 class="font-weight-bold">
            T-Shirtler
        </h2>

        <p class="text-muted">
            Tarzına uygun T-Shirt modellerini keşfet.
        </p>

    </div>


    <div class="row px-xl-5">

        <!-- FİLTRE -->
        <div class="col-lg-3 col-md-4">

            <div class="border p-4 mb-4">

                <h5 class="font-weight-bold mb-4">
                    Filtrele
                </h5>

                <h6 class="font-weight-bold">
                    Beden
                </h6>

                <div class="mb-4">

                    <label class="d-block">
                        <input type="checkbox" /> S
                    </label>

                    <label class="d-block">
                        <input type="checkbox" /> M
                    </label>

                    <label class="d-block">
                        <input type="checkbox" /> L
                    </label>

                    <label class="d-block">
                        <input type="checkbox" /> XL
                    </label>

                </div>


                <h6 class="font-weight-bold">
                    Fiyat
                </h6>

                <label class="d-block">
                    <input type="checkbox" /> 0₺ - 500₺
                </label>

                <label class="d-block">
                    <input type="checkbox" /> 500₺ - 1000₺
                </label>

                <label class="d-block">
                    <input type="checkbox" /> 1000₺ ve üzeri
                </label>

            </div>

        </div>


        <!-- ÜRÜNLER -->
        <div class="col-lg-9 col-md-8">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h5 class="font-weight-bold mb-0">
                    T-Shirtler
                </h5>

                <select class="form-control" style="width: 220px;">
                    <option>Önerilen</option>
                    <option>Fiyat: Düşükten Yükseğe</option>
                    <option>Fiyat: Yüksekten Düşüğe</option>
                    <option>Yeni Ürünler</option>
                </select>

            </div>


            <div class="row">

                <!-- ÜRÜN 1 -->
                <div class="col-lg-4 col-md-6 col-sm-6 pb-1">

                    <div class="card product-item border-0 mb-4">

                        <div class="product-img position-relative overflow-hidden">
                            <img class="img-fluid w-100"
                                 src="~/images/Hermes Siyah.jpeg"
                                 alt="Siyah Hermes T-Shirt">
                        </div>

                        <div class="card-body text-center p-3">

                            <h6 class="text-truncate mb-2">
                                Siyah Hermes T-Shirt
                            </h6>

                            <div class="d-flex justify-content-center">

                                <h6>500.00₺</h6>

                                <h6 class="text-muted ml-2">
                                    <del>600.00₺</del>
                                </h6>

                            </div>

                        </div>

                        <div class="card-footer bg-white border-0 pt-0 text-center">

                            <a href="#" class="btn btn-sm btn-outline-primary mr-1">
                                <i class="fas fa-eye mr-1"></i>
                                Detay
                            </a>

                            <a href="#" class="btn btn-sm btn-primary">
                                <i class="fas fa-shopping-cart mr-1"></i>
                                Sepete Ekle
                            </a>

                        </div>

                    </div>

                </div>


                <!-- ÜRÜN 2 -->
                <div class="col-lg-4 col-md-6 col-sm-6 pb-1">

                    <div class="card product-item border-0 mb-4">

                        <div class="product-img position-relative overflow-hidden">
                            <img class="img-fluid w-100"
                                 src="~/images/Burbery Siyah.jpeg"
                                 alt="Burberry Siyah T-Shirt">
                        </div>

                        <div class="card-body text-center p-3">

                            <h6 class="text-truncate mb-2">
                                Burberry Siyah T-Shirt
                            </h6>

                            <div class="d-flex justify-content-center">

                                <h6>500.00₺</h6>

                                <h6 class="text-muted ml-2">
                                    <del>600.00₺</del>
                                </h6>

                            </div>

                        </div>

                        <div class="card-footer bg-white border-0 pt-0 text-center">

                            <a href="#" class="btn btn-sm btn-outline-primary mr-1">
                                <i class="fas fa-eye mr-1"></i>
                                Detay
                            </a>

                            <a href="#" class="btn btn-sm btn-primary">
                                <i class="fas fa-shopping-cart mr-1"></i>
                                Sepete Ekle
                            </a>

                        </div>

                    </div>

                </div>


                <!-- ÜRÜN 3 -->
                <div class="col-lg-4 col-md-6 col-sm-6 pb-1">

                    <div class="card product-item border-0 mb-4">

                        <div class="product-img position-relative overflow-hidden">
                            <img class="img-fluid w-100"
                                 src="~/images/Dior Siyah.jpeg"
                                 alt="Dior Siyah T-Shirt">
                        </div>

                        <div class="card-body text-center p-3">

                            <h6 class="text-truncate mb-2">
                                Dior Siyah T-Shirt
                            </h6>

                            <div class="d-flex justify-content-center">

                                <h6>550.00₺</h6>

                                <h6 class="text-muted ml-2">
                                    <del>650.00₺</del>
                                </h6>

                            </div>

                        </div>

                        <div class="card-footer bg-white border-0 pt-0 text-center">

                            <a href="#" class="btn btn-sm btn-outline-primary mr-1">
                                <i class="fas fa-eye mr-1"></i>
                                Detay
                            </a>

                            <a href="#" class="btn btn-sm btn-primary">
                                <i class="fas fa-shopping-cart mr-1"></i>
                                Sepete Ekle
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>