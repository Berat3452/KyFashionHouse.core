            <h1 class="fa fa-phone-volume text-primary m-0 mr-3"></h1>

            <h5 class="font-weight-semi-bold m-0">
                7/24 Destek
            </h5>

        </div>
    </div>

</div>


<!-- KAMPANYA / CAROUSEL -->
<div class="row px-xl-5 pb-3">

    <div class="col-lg-12">

        <div id="header-carousel"
             class="carousel slide"
             data-ride="carousel">

            <ol class="carousel-indicators">

                <li data-target="#header-carousel"
                    data-slide-to="0"
                    class="active"></li>

                <li data-target="#header-carousel"
                    data-slide-to="1"></li>

                <li data-target="#header-carousel"
                    data-slide-to="2"></li>

            </ol>


            <div class="carousel-inner">

                <!-- SLIDE 1 -->
                <div class="carousel-item active"
                     style="height: 410px;">

                    <img class="w-100 h-100"
                         src="~/eshopper-1.0.0/img/carousel-1.jpg"
                         style="object-fit: cover;"
                         alt="Kaliteli Ürünler">

                    <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">

                        <div class="p-3"
                             style="max-width: 700px;">

                            <h4 class="text-light text-uppercase font-weight-medium mb-3">
                                Kaliteli Ürünler
                            </h4>

                            <h3 class="display-4 text-white font-weight-semi-bold mb-4">
                                Tarzını Yansıt
                            </h3>

                            <a href="#"
                               class="btn btn-light py-2 px-3">
                                Alışverişe Başla
                            </a>

                        </div>

                    </div>

                </div>


                <!-- SLIDE 2 -->
                <div class="carousel-item"
                     style="height: 410px;">

                    <img class="w-100 h-100"
                         src="~/eshopper-1.0.0/img/carousel-2.jpg"
                         style="object-fit: cover;"
                         alt="Modaya Uygun Kıyafetler">

                    <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">

                        <div class="p-3"
                             style="max-width: 700px;">

                            <h4 class="text-light text-uppercase font-weight-medium mb-3">
                                Modaya Uygun Kıyafetler
                            </h4>

                            <h3 class="display-4 text-white font-weight-semi-bold mb-4">
                                Yeni Sezon
                            </h3>

                            <a href="#"
                               class="btn btn-light py-2 px-3">
                                Alışverişe Başla
                            </a>

                        </div>

                    </div>

                </div>


                <!-- SLIDE 3 -->
                <div class="carousel-item"
                     style="height: 410px;">

                    <img class="w-100 h-100"
                         src="~/eshopper-1.0.0/img/carousel-1.jpg"
                         style="object-fit: cover;"
                         alt="Alışverişe Başla">

                    <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">

                        <div class="p-3"
                             style="max-width: 700px;">

                            <h4 class="text-light text-uppercase font-weight-medium mb-3">
                                Ky Fashion House
                            </h4>

                            <h3 class="display-4 text-white font-weight-semi-bold mb-4">
                                Alışverişe Başla
                            </h3>

                            <a href="#"
                               class="btn btn-light py-2 px-3">
                                Ürünleri Gör
                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <a class="carousel-control-prev"
               href="#header-carousel"
               data-slide="prev">

                <span class="carousel-control-prev-icon"></span>

            </a>


            <a class="carousel-control-next"
               href="#header-carousel"
               data-slide="next">

                <span class="carousel-control-next-icon"></span>

            </a>

        </div>

    </div>

</div>


